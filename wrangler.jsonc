{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ac-care",
	"main": "cloudflare/src/index.js",
	"compatibility_date": "2026-11-07",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"observability": {
		"enabled": true
	}
}
